# Loki website links. Copy this file to ".env", fill in what you have, then
# rebuild and redeploy (npm run deploy). Leave a value empty and the link
# points to a section of the page instead, so nothing ever breaks.

# "Get Loki" buttons: direct link to the Android APK.
# GitHub Releases works well and is free; this form always serves the newest release:
#   https://github.com/<you>/<repo>/releases/latest/download/loki.apk
VITE_LOKI_DOWNLOAD_URL=

# Telegram announcements channel, e.g. https://t.me/lokivoice
VITE_LOKI_TELEGRAM_CHANNEL_URL=

# Community section: feedback / bug-report form (e.g. a free Tally form)
# and your Telegram discussion group. Empty = the Telegram channel above.
VITE_LOKI_FEEDBACK_URL=
VITE_LOKI_COMMUNITY_URL=

# Customer support chat, e.g. https://t.me/lokivoice_support
VITE_LOKI_SUPPORT_URL=
# Used for "Contact" when the support chat above is empty.
VITE_LOKI_SUPPORT_EMAIL=

# Name of whoever runs Loki, shown in the Privacy and Terms pages
# (your registered business name, if you have one). Empty = "Loki".
VITE_LOKI_LEGAL_NAME=

# Only if you host these pages elsewhere. Empty = the site's own
# /setup, /privacy and /terms pages.
VITE_LOKI_SETUP_GUIDE_URL=
VITE_LOKI_PRIVACY_URL=
VITE_LOKI_TERMS_URL=

# Partner dashboard and application form
VITE_LOKI_API_URL=https://api.3-252-253-247.sslip.io
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_LOKI_PARTNER_FORM_URL=
